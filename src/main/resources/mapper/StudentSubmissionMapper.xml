<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ccut.mapper.StudentSubmissionMapper">
    <insert id="insert">
    INSERT INTO student_submissions
    <trim prefix="(" suffix=")" suffixOverrides=",">
        <if test="assignmentId != null">
            assignment_id,
        </if>

        <if test="studentId != null">
            student_id,
        </if>
        <if test="submissionContent != null and submissionContent != ''">
            submission_content,
        </if>
        <if test="submissionFiles != null and submissionFiles != ''">
            submission_files,
        </if>

        created_at
    </trim>
    <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
        <if test="assignmentId != null">
            #{assignmentId},
        </if>

        <if test="studentId != null">
            #{studentId},
        </if>
        <if test="submissionContent != null and submissionContent != ''">
            #{submissionContent},
        </if>
        <if test="submissionFiles != null and submissionFiles != ''">
            #{submissionFiles},
        </if>

        <if test="submittedAt != null">
            #{submittedAt},
        </if>
        CURRENT_TIMESTAMP
    </trim>
</insert>

	<resultMap id="StudentSubmissionRM" type="com.ccut.entity.StudentSubmission">
		<id property="submissionId" column="submission_id"/>
		<result property="assignmentId" column="assignment_id"/>
		<result property="groupId" column="group_id"/>
		<result property="submissionContent" column="submission_content"/>
		<result property="submissionFiles" column="submission_files"/>
		<result property="submittedAt" column="submitted_at"/>
		<result property="status" column="status"/>
		<result property="createdAt" column="created_at"/>
		<result property="updatedAt" column="updated_at"/>
	</resultMap>

	<select id="selectById" resultMap="StudentSubmissionRM">
		SELECT * FROM student_submissions WHERE submission_id = #{submissionId}
	</select>

	<select id="selectByAssignmentId" resultMap="StudentSubmissionRM">
		SELECT * FROM student_submissions WHERE assignment_id = #{assignmentId} ORDER BY submitted_at DESC
	</select>

	<select id="selectByGroupId" resultMap="StudentSubmissionRM">
		SELECT * FROM student_submissions WHERE group_id = #{groupId} ORDER BY submitted_at DESC
	</select>

</mapper>