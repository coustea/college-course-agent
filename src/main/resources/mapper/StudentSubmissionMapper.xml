<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ccut.mapper.StudentSubmissionMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="submissionId" keyColumn="submission_id">
    INSERT INTO student_submissions
    <trim prefix="(" suffix=")" suffixOverrides=",">
        <if test="assignmentId != null">
            assignment_id,
        </if>

        <if test="groupId != null">
            group_id,
        </if>

        <if test="submittedBy != null">
            submitted_by,
        </if>
        <if test="submissionContent != null and submissionContent != ''">
            submission_content,
        </if>
        <if test="submissionFiles != null and submissionFiles != ''">
            submission_files,
        </if>

        created_at
    </trim>
    <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
        <if test="assignmentId != null">
            #{assignmentId},
        </if>

        <if test="groupId != null">
            #{groupId},
        </if>

        <if test="submittedBy != null">
            #{submittedBy},
        </if>
        <if test="submissionContent != null and submissionContent != ''">
            #{submissionContent},
        </if>
        <if test="submissionFiles != null and submissionFiles != ''">
            #{submissionFiles},
        </if>
        CURRENT_TIMESTAMP
    </trim>
</insert>

	<resultMap id="StudentSubmissionRM" type="com.ccut.entity.StudentSubmission">
		<id property="submissionId" column="submission_id"/>
		<result property="assignmentId" column="assignment_id"/>
		<result property="groupId" column="group_id"/>
		<result property="submissionContent" column="submission_content"/>
		<result property="submissionFiles" column="submission_files"/>
		<result property="submittedAt" column="submitted_at"/>
		<result property="status" column="status"/>
		<result property="createdAt" column="created_at"/>
		<result property="updatedAt" column="updated_at"/>
	</resultMap>

	<select id="selectById" resultMap="StudentSubmissionRM">
		SELECT * FROM student_submissions WHERE submission_id = #{submissionId}
	</select>

	<select id="selectByAssignmentId" resultMap="StudentSubmissionRM">
		SELECT * FROM student_submissions WHERE assignment_id = #{assignmentId} ORDER BY submitted_at DESC
	</select>

	<select id="selectByGroupId" resultMap="StudentSubmissionRM">
		SELECT * FROM student_submissions WHERE group_id = #{groupId} ORDER BY submitted_at DESC
	</select>

	<update id="updateById">
		UPDATE student_submissions
		<set>
			<if test="submissionContent != null">submission_content = #{submissionContent},</if>
			<if test="submissionFiles != null">submission_files = #{submissionFiles},</if>
			updated_at = CURRENT_TIMESTAMP
		</set>
		WHERE submission_id = #{submissionId}
	</update>

	<select id="selectByAssignmentIdAndGroupId" resultMap="StudentSubmissionRM">
		SELECT * FROM student_submissions 
		WHERE assignment_id = #{assignmentId} AND group_id = #{groupId} 
		ORDER BY submitted_at DESC 
		LIMIT 1
	</select>

	<select id="selectAll" resultMap="StudentSubmissionRM">
		SELECT * FROM student_submissions ORDER BY submitted_at DESC
	</select>

</mapper>