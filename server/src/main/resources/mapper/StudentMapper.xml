<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ccut.mapper.StudentMapper">
    <insert id="insertStudent" parameterType="com.ccut.entity.Student">
        INSERT INTO students (
        <trim suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="studentNumber != null">student_number,</if>
            <if test="name != null">name,</if>
            <if test="className != null">class_name,</if>
            <if test="email != null">email,</if>
            <if test="phone != null">phone,</if>
            <if test="major != null">major,</if>
            <if test="grade != null">grade,</if>
            <if test="status != null">status,</if>
            <if test="groupStatus != null">group_status,</if>
        </trim>
        ) VALUES (
        <trim suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="studentNumber != null">#{studentNumber},</if>
            <if test="name != null">#{name},</if>
            <if test="className != null">#{className},</if>
            <if test="email != null">#{email},</if>
            <if test="phone != null">#{phone},</if>
            <if test="major != null">#{major},</if>
            <if test="grade != null">#{grade},</if>
            <if test="status != null">#{status},</if>
            <if test="groupStatus != null">#{groupStatus},</if>
        </trim>
        )
    </insert>

    <update id="updateById">
        UPDATE students
        <set>
            <if test="studentNumber != null">student_number = #{studentNumber},</if>
            <if test="name != null">name = #{name},</if>
            <if test="email != null">email = #{email},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="className != null">class_name = #{className},</if>
            <if test="major != null">major = #{major},</if>
            <if test="grade != null">grade = #{grade},</if>
            <if test="status != null">status = #{status},</if>
            <if test="groupStatus != null">group_status = #{groupStatus},</if>
        </set>
        WHERE id = #{id}
    </update>

    <resultMap id="StudentRM" type="com.ccut.entity.Student">
        <id property="id" column="id"/>
        <result property="studentNumber" column="student_number"/>
        <result property="name" column="name"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="className" column="class_name"/>
        <result property="major" column="major"/>
        <result property="grade" column="grade"/>
        <result property="status" column="status"/>
        <result property="groupStatus" column="group_status"/>
    </resultMap>
    <select id="getStudentByStudentNumber" resultMap="StudentRM">
        SELECT id, student_number, name, email, phone, class_name, major, grade, status, group_status
        FROM students
        WHERE student_number = #{studentNumber}
    </select>

    <delete id="deleteById">
        DELETE FROM students WHERE id = #{id}
    </delete>

    <select id="selectAll" resultMap="StudentRM">
        SELECT id, student_number, name, email, phone, class_name, major, grade, status
        FROM students
        ORDER BY id DESC
    </select>

    <select id="selectById" resultMap="StudentRM">
        SELECT id, student_number, name, email, phone, class_name, major, grade, status
        FROM students
        WHERE id = #{id}
    </select>

    <select id="selectByGrade" resultMap="StudentRM">
        SELECT id, student_number, name, email, phone, class_name, major, grade, status
        FROM students
        WHERE grade = #{grade}
        ORDER BY id DESC
    </select>
    <select id="selectByClassName" resultMap="StudentRM">
        SELECT id, student_number, name, email, phone, class_name, major, grade, status,group_status
        FROM students
        WHERE class_name = #{className}

    </select>

    <!-- 推荐系统需要的辅助方法 -->
    <select id="findAllStudentIds" resultType="java.lang.Long">
        SELECT id
        FROM students
        ORDER BY id DESC
    </select>

    <!-- 根据学号列表批量查询学生 -->
    <select id="findByStudentNumbers" resultMap="StudentRM">
        SELECT id, student_number, name, email, phone, class_name, major, grade, status, group_status
        FROM students
        WHERE student_number IN
        <foreach collection="studentNumbers" item="studentNumber" open="(" separator="," close=")">
            #{studentNumber}
        </foreach>
    </select>

</mapper>